{
  "name": "inkdesk",
  "productName": "Aster*",
  "version": "0.2.7",
  "description": "Aster* — local writing desk for Content OS",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node dev.cjs",
    "dev:server": "node server.cjs",
    "build:watch": "esbuild renderer.js --bundle --format=esm --outfile=bundle.js --watch",
    "test": "node --test test.cjs vault.test.cjs knowledge.test.cjs model.test.cjs note-import.test.cjs skills.test.cjs agent-models.test.cjs agent-usage.test.cjs update.test.cjs review-diff.test.cjs wechat-png.test.cjs groups.test.cjs",
    "package:mac": "node package-mac.cjs",
    "build": "esbuild renderer.js --bundle --format=esm --outfile=bundle.js",
    "test:ui": "node smoke-ui.cjs && node review-ui.cjs && node skills-ui-test.cjs && node heatmap-ui.cjs && node agents-ui.cjs && node usage-ui.cjs",
    "test:budget": "node scripts/budget-check.cjs",
    "test:skills": "node skills-ui-test.cjs",
    "test:agents": "node agents-ui.cjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "diff": "^9.0.0",
    "lucide": "^1.47.0",
    "marked": "^15.0.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6"
  }
}
