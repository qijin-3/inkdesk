{
  "name": "inkdesk",
  "productName": "AsIde",
  "version": "0.1.1",
  "description": "AsIde — local writing desk for Content OS",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node dev.cjs",
    "dev:server": "node server.cjs",
    "build:watch": "esbuild renderer.js --bundle --format=esm --outfile=bundle.js --watch",
    "test": "node --test test.cjs vault.test.cjs knowledge.test.cjs model.test.cjs note-import.test.cjs",
    "package:mac": "electron-packager . AsIde --platform=darwin --arch=arm64 --out=dist-v4 --overwrite --icon=assets/AsIde.icns --ignore='^/data(/|$)' --ignore='^/dist' --ignore='screenshot-' --ignore='/(vault|development-vault)\\.json$' --ignore='/(vault|knowledge|model|note-import)\\.test\\.cjs$' --ignore='/test\\.cjs$' --ignore='/(smoke|review|social|workflow|packaged|real-vault|live-agent)[^/]*\\.cjs$' --ignore='^/dist-' --extra-resource=assets/reference-reader",
    "build": "esbuild renderer.js --bundle --format=esm --outfile=bundle.js",
    "test:ui": "node smoke-ui.cjs && node review-ui.cjs && node workflow-v4.cjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "diff": "^9.0.0",
    "lucide": "^1.47.0",
    "marked": "^15.0.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6"
  }
}
